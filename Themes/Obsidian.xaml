<!--
    Soundz — tema Obsidian & Ruby
    ================================================================

    Este arquivo é um ResourceDictionary: um "dicionário" de recursos
    reutilizáveis (cores, fontes, desenhos e aparências de controle).
    O App.xaml carrega ele uma vez e tudo no app pode usar via
    {StaticResource NomeDaChave}.

    A parte importante do WPF que aparece aqui é o ControlTemplate:
    ele redesenha um controle do zero (o visual), sem mexer no
    comportamento (clicar, arrastar, abrir a lista). É por isso que
    dá pra deixar um ComboBox com essa cara sem reimplementar nada.

    Ordem importa: um recurso só pode referenciar outro definido ANTES
    dele no arquivo.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         1. CORES
         O #FF na frente é o alfa (FF = 100% opaco).
         ============================================================ -->
    <Color x:Key="VoidColor">#FF0D0D10</Color>
    <Color x:Key="ObsidianColor">#FF1B1B1B</Color>
    <Color x:Key="ElevatedColor">#FF232327</Color>
    <Color x:Key="HoverColor">#FF2E2E34</Color>
    <Color x:Key="StrokeColor">#FF46464F</Color>

    <Color x:Key="RubyColor">#FF9B111E</Color>
    <Color x:Key="RubyGlowColor">#FFFF2E4C</Color>
    <Color x:Key="RubyDeepColor">#FF5E0A13</Color>
    <Color x:Key="RubyHoverColor">#FFB51524</Color>

    <Color x:Key="EmeraldColor">#FF10B981</Color>
    <Color x:Key="EmeraldDeepColor">#FF0A7355</Color>

    <Color x:Key="WarnColor">#FFFFB020</Color>

    <Color x:Key="TextHiColor">#FFFFFFFF</Color>
    <Color x:Key="TextMidColor">#FFA9A6B0</Color>
    <Color x:Key="TextDimColor">#FF7E7B8A</Color>

    <!-- ============================================================
         2. PINCÉIS (Brush)
         Cor é só o valor; pincel é o que pinta de fato. Controles
         pedem pincel, não cor.
         ============================================================ -->
    <SolidColorBrush x:Key="Void" Color="{StaticResource VoidColor}"/>
    <SolidColorBrush x:Key="Obsidian" Color="{StaticResource ObsidianColor}"/>
    <SolidColorBrush x:Key="Elevated" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}"/>
    <SolidColorBrush x:Key="ComboBorder" Color="#FF33333A"/>
    <SolidColorBrush x:Key="Divider" Color="#FF26262C"/>

    <SolidColorBrush x:Key="Ruby" Color="{StaticResource RubyColor}"/>
    <SolidColorBrush x:Key="RubyGlow" Color="{StaticResource RubyGlowColor}"/>
    <SolidColorBrush x:Key="RubyDeep" Color="{StaticResource RubyDeepColor}"/>
    <SolidColorBrush x:Key="RubyHover" Color="{StaticResource RubyHoverColor}"/>
    <SolidColorBrush x:Key="RubyFaint" Color="{StaticResource RubyGlowColor}" Opacity="0.32"/>

    <SolidColorBrush x:Key="Emerald" Color="{StaticResource EmeraldColor}"/>
    <SolidColorBrush x:Key="EmeraldDeep" Color="{StaticResource EmeraldDeepColor}"/>
    <SolidColorBrush x:Key="EmeraldFaint" Color="{StaticResource EmeraldColor}" Opacity="0.13"/>

    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnFaint" Color="{StaticResource WarnColor}" Opacity="0.13"/>

    <SolidColorBrush x:Key="TextHi" Color="{StaticResource TextHiColor}"/>
    <SolidColorBrush x:Key="TextMid" Color="{StaticResource TextMidColor}"/>
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}"/>

    <SolidColorBrush x:Key="WinCloseHover" Color="{StaticResource RubyColor}"/>
    <SolidColorBrush x:Key="WhiteFaint" Color="#FFFFFFFF" Opacity="0.08"/>

    <!-- Brilho do topo da área de sons: luz vindo de um disco distante. -->
    <RadialGradientBrush x:Key="StageGlow" GradientOrigin="0.5,-0.14" Center="0.5,-0.14"
                         RadiusX="0.88" RadiusY="0.62">
        <GradientStop Offset="0" Color="#4D9B111E"/>
        <GradientStop Offset="0.46" Color="#0F9B111E"/>
        <GradientStop Offset="1" Color="#009B111E"/>
    </RadialGradientBrush>

    <!-- Gradiente do disco de acreção. MappingMode=Absolute faz as duas
         metades do disco (elipse e arco) compartilharem o mesmo eixo de
         gradiente, senão cada uma calcularia o seu e a emenda apareceria. -->
    <LinearGradientBrush x:Key="DiskBrush" MappingMode="Absolute" StartPoint="5,45" EndPoint="59,19">
        <GradientStop Offset="0" Color="{StaticResource RubyDeepColor}"/>
        <GradientStop Offset="0.42" Color="{StaticResource RubyColor}"/>
        <GradientStop Offset="0.78" Color="{StaticResource RubyGlowColor}"/>
        <GradientStop Offset="1" Color="#FFFF7A8C"/>
    </LinearGradientBrush>

    <!-- ============================================================
         3. TIPOGRAFIA
         Segoe UI Variable já vem no Windows 11. Display para títulos,
         Text para o resto — é para isso que a família foi desenhada.
         A vírgula é fallback: se a primeira não existir, usa a próxima.
         ============================================================ -->
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>

    <sys:Double x:Key="RadiusSm">4</sys:Double>
    <CornerRadius x:Key="CornerSm">4</CornerRadius>
    <CornerRadius x:Key="CornerMd">8</CornerRadius>

    <!-- Não existe "pílula" automática no WPF: um Border com CornerRadius maior
         que metade da altura não faz clamp como o CSS — ele deforma. Por isso
         cada pílula tem altura fixa e raio igual à metade exata dela. -->
    <sys:Double x:Key="PillHeight">44</sys:Double>
    <CornerRadius x:Key="CornerPill">22</CornerRadius>
    <sys:Double x:Key="GhostHeight">34</sys:Double>
    <CornerRadius x:Key="CornerGhost">17</CornerRadius>
    <CornerRadius x:Key="CornerChip">9</CornerRadius>
    <CornerRadius x:Key="CornerToggle">10</CornerRadius>

    <!-- ============================================================
         4. A MARCA
         Um DrawingImage é uma imagem feita de vetores, não de pixels —
         serve tanto para o <Image> da barra de título quanto para o
         Window.Icon, e escala sem borrar.

         Três peças, na ordem em que são pintadas:
           1. disco de acreção (elipse inclinada -18°)
           2. horizonte de eventos (círculo escuro, cobre o meio do disco)
           3. lente gravitacional (o arco da frente, por cima do horizonte)
         ============================================================ -->
    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Retângulo transparente só para fixar o "quadro" em 64x64.
                     Sem ele a imagem se ajustaria aos limites do desenho. -->
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource DiskBrush}" Thickness="5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,32" RadiusX="27" RadiusY="10">
                            <EllipseGeometry.Transform>
                                <RotateTransform Angle="-18" CenterX="32" CenterY="32"/>
                            </EllipseGeometry.Transform>
                        </EllipseGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="{StaticResource Void}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,32" RadiusX="12.5" RadiusY="12.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource DiskBrush}" Thickness="5"
                             StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <!-- A = arco. Sintaxe: A raioX,raioY rotação arcoGrande sentido destino -->
                        <PathGeometry Figures="M 6.32,40.34 A 27,10 -18 0 0 57.68,23.66"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        Variante de ícone (barra de título, ícone da janela, barra de tarefas).
        A 19px o traço de 5 do desenho grande vira 1,5px e o horizonte engole o
        resto — some tudo. Aqui o disco engrossa para 8 e o horizonte encolhe
        para 11: mesma silhueta, detalhe suficiente para sobreviver ao tamanho.
    -->
    <DrawingImage x:Key="LogoIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource DiskBrush}" Thickness="8"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,32" RadiusX="27" RadiusY="10">
                            <EllipseGeometry.Transform>
                                <RotateTransform Angle="-18" CenterX="32" CenterY="32"/>
                            </EllipseGeometry.Transform>
                        </EllipseGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="{StaticResource Void}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,32" RadiusX="11" RadiusY="11"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource DiskBrush}" Thickness="8"
                             StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 6.32,40.34 A 27,10 -18 0 0 57.68,23.66"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============================================================
         5. ÍCONES (Geometry = só a forma; quem pinta é o Path que usa)
         ============================================================ -->
    <PathGeometry x:Key="IconWave"
        Figures="M 2,6.5 L 2,9.5 M 7,4 L 7,12 M 12,1.5 L 12,14.5 M 17,5 L 17,11 M 22,6.5 L 22,9.5"/>
    <PathGeometry x:Key="IconPlay" Figures="M 2,1 L 11,6 L 2,11 Z"/>
    <RectangleGeometry x:Key="IconStop" Rect="2,2,8,8" RadiusX="1" RadiusY="1"/>
    <!-- Pausa: duas barras. Transporte anterior/próximo: barra + triângulo. -->
    <PathGeometry x:Key="IconPause"
        Figures="M 2.5,1.5 L 4.8,1.5 L 4.8,10.5 L 2.5,10.5 Z M 7.2,1.5 L 9.5,1.5 L 9.5,10.5 L 7.2,10.5 Z"/>
    <PathGeometry x:Key="IconPrev"
        Figures="M 1.5,1.5 L 3.2,1.5 L 3.2,10.5 L 1.5,10.5 Z M 10.5,1.5 L 10.5,10.5 L 4,6 Z"/>
    <PathGeometry x:Key="IconNext"
        Figures="M 10.5,1.5 L 8.8,1.5 L 8.8,10.5 L 10.5,10.5 Z M 1.5,1.5 L 1.5,10.5 L 8,6 Z"/>
    <PathGeometry x:Key="IconCheck" Figures="M 2,6.5 L 4.8,9.3 L 10,3.5"/>
    <!-- Triangulo de aviso. O ultimo trecho, de 6,9.2 a 6,9.25, e curto de
         proposito: com ponta redonda ele vira o pontinho embaixo do "!".
         Comprimento zero nao desenha nada, dai o 0.05. -->
    <PathGeometry x:Key="IconAlert"
                  Figures="M 6,1.4 L 11.2,10.6 L 0.8,10.6 Z M 6,4.6 L 6,7.4 M 6,9.2 L 6,9.25"/>
    <PathGeometry x:Key="IconTrash"
        Figures="M 1.5,3 L 10.5,3 M 4.5,3 L 4.5,1.5 L 7.5,1.5 L 7.5,3 M 2.6,3 L 3.3,10.5 L 8.7,10.5 L 9.4,3"/>
    <PathGeometry x:Key="IconHeadphones"
        Figures="M 3,16 L 3,12 A 9,9 0 0 1 21,12 L 21,16 M 21,17 A 2,2 0 0 1 19,19 L 18,19 L 18,13 L 19,13 A 2,2 0 0 1 21,15 Z M 3,17 A 2,2 0 0 0 5,19 L 6,19 L 6,13 L 5,13 A 2,2 0 0 0 3,15 Z"/>
    <PathGeometry x:Key="IconMinimize" Figures="M 0,5 L 10,5"/>
    <RectangleGeometry x:Key="IconMaximize" Rect="0.5,0.5,9,9"/>
    <!-- Restaurar: dois quadrados sobrepostos, como no Windows. -->
    <PathGeometry x:Key="IconRestore"
        Figures="M 2.5,2.5 L 2.5,0.5 L 9.5,0.5 L 9.5,7.5 L 7.5,7.5 M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z"/>
    <PathGeometry x:Key="IconClose" Figures="M 0,0 L 10,10 M 10,0 L 0,10"/>

    <!-- ============================================================
         6. BARRA DE ROLAGEM
         A padrão do WPF é cinza claro e destruiria o visual escuro.
         ============================================================ -->
    <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bar" Background="{StaticResource Stroke}"
                            CornerRadius="3" Margin="3,0,3,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource TextDim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         7. DICA DE FERRAMENTA (ToolTip)
         ============================================================ -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{StaticResource Elevated}"
                            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="{StaticResource CornerSm}" Padding="9,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         8. TEXTOS
         ============================================================ -->
    <Style x:Key="RailLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <!-- Não existe text-transform no WPF: o texto vai em maiúsculo no XAML mesmo. -->
    </Style>

    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="StageTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
    </Style>

    <!-- ============================================================
         9. BOTÃO PRIMÁRIO — pílula Ruby (Iniciar)
         O brilho no hover é um DropShadowEffect vermelho com
         ShadowDepth 0, ou seja, um halo em volta e não uma sombra.
         ============================================================ -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Height" Value="{StaticResource PillHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Pill" Background="{StaticResource Ruby}"
                            CornerRadius="{StaticResource CornerPill}"
                            RenderTransformOrigin="0.5,0.5">
                        <TextBlock Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource RubyHover}"/>
                            <!-- Um Setter não consegue mirar dentro de um transform
                                 (transform não é elemento). Então troca-se o
                                 RenderTransform inteiro do Border. -->
                            <Setter TargetName="Pill" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Pill" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource RubyColor}" BlurRadius="22"
                                                      ShadowDepth="0" Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource RubyDeep}"/>
                            <Setter TargetName="Pill" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource TextHi}"/>
                            <Setter TargetName="Pill" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante "rodando" (Parar): contorno, sem preenchimento, para não
         competir com o card que está tocando. O code-behind troca o Style. -->
    <Style x:Key="PrimaryButtonRunning" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Pill" Background="Transparent"
                            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="{StaticResource CornerPill}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource WhiteFaint}"/>
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource TextHi}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         10. BOTÃO FANTASMA — "+ Adicionar som"
         ============================================================ -->
    <Style x:Key="GhostButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="{StaticResource GhostHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Pill" Background="Transparent"
                            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="{StaticResource CornerGhost}" Padding="16,0"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource RubyGlow}"/>
                            <Setter TargetName="Pill" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         11. BOTÕES DA BARRA DE TÍTULO
         ============================================================ -->
    <Style x:Key="WindowButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Back" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource WhiteFaint}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fechar acende em Ruby — é o único lugar do chrome onde a marca aparece. -->
    <Style x:Key="WindowCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Back" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource WinCloseHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         12. BOTÃO DE ÍCONE (barra de reprodução)
         ============================================================ -->
    <Style x:Key="IconButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" Padding="5" CornerRadius="{StaticResource CornerSm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão redondo branco de play/parar da barra de baixo. -->
    <Style x:Key="TransportButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Knob" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="{StaticResource TextHi}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.07" ScaleY="1.07"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         13. COMBOBOX
         Um ComboBox tem duas partes: o botão que mostra a seleção
         (ToggleButton) e a lista que abre (Popup). Os dois precisam
         de template, senão a lista abre branca.
         ============================================================ -->
    <Style x:Key="ComboToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Box" Background="{StaticResource Elevated}"
                            BorderBrush="{StaticResource ComboBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource CornerSm}">
                        <!-- A setinha, desenhada na mão -->
                        <Path x:Name="Arrow" Data="M 1,1 L 5,5 L 9,1"
                              Stroke="{StaticResource TextMid}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Stroke}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Emerald}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkCombo" TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>

                        <!-- O texto da seleção. IsHitTestVisible=False deixa o clique
                             passar direto para o ToggleButton atrás. -->
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"
                                          Margin="10,0,30,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"/>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource Elevated}"
                                    BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    CornerRadius="{StaticResource CornerSm}" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF000000" BlurRadius="18" ShadowDepth="4" Opacity="0.6"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         14. SLIDER
         O Track do WPF tem três partes: o pedaço antes do thumb
         (DecreaseRepeatButton = a parte "cheia"), o thumb, e o pedaço
         depois (IncreaseRepeatButton = a parte "vazia"). Pintando os
         dois RepeatButtons de cores diferentes sai a barra preenchida.
         ============================================================ -->
    <!-- Só as pontas EXTERNAS da barra são arredondadas. Se as internas também
         fossem, apareceria um entalhe onde cada metade encosta no thumb. -->
    <Style x:Key="SliderFill" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="{StaticResource TextHi}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="4" CornerRadius="2,0,0,2" VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmpty" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource SliderFill}">
        <Setter Property="Background" Value="{StaticResource Stroke}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="4" CornerRadius="0,2,2,0" VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        O Track reserva a largura do thumb entre as duas metades do trilho.
        Com a bolinha invisível em repouso (estilo Spotify), sobrava um buraco
        de 12px mostrando o fundo preto. Por isso o thumb desenha ele mesmo o
        pedaço de trilho por baixo — a barra fica contínua, e a bolinha só
        aparece no hover por cima dela.
    -->
    <!-- Largura 16 (e não 12) porque a bolinha cresce para 14 no hover: se o
         Thumb tivesse o tamanho exato dela, ela transbordaria e apareceria
         cortada. O Border interno cobre os 16px inteiros, então o trilho segue
         contínuo mesmo com o vão maior. -->
    <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource TextHi}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <!-- A emenda é dividida ao meio: à ESQUERDA da bolinha ela
                             continua a parte preenchida, à DIREITA já é trilho vazio.
                             Se fosse tudo de uma cor só, a barra vazaria para além
                             da bolinha e o valor pareceria maior do que é. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BridgeLeft" Grid.Column="0" Height="4" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"/>
                        <Border Grid.Column="1" Height="4" VerticalAlignment="Center"
                                Background="{StaticResource Stroke}"/>
                        <!-- A bolinha fica sempre visível (o Spotify só mostra no
                             hover, mas para volume é mais claro ver sempre onde
                             está o valor). No hover ela cresce um pouco. -->
                        <Ellipse x:Name="Knob" Grid.ColumnSpan="2" Width="12" Height="12"
                                 Fill="{StaticResource TextHi}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- No zero não existe nada preenchido, então a metade
                             esquerda da emenda vira trilho vazio também — senão
                             sobra um risquinho claro à esquerda da bolinha.
                             (Todos os sliders do app têm Minimum = 0.) -->
                        <DataTrigger Value="0"
                                     Binding="{Binding Value,
                                               RelativeSource={RelativeSource AncestorType={x:Type Slider}}}">
                            <Setter TargetName="BridgeLeft" Property="Background"
                                    Value="{StaticResource Stroke}"/>
                        </DataTrigger>

                        <!-- A bolinha reage ao Slider inteiro, não só a si mesma:
                             o RelativeSource sobe até o Slider e lê o estado dele. -->
                        <DataTrigger Value="True"
                                     Binding="{Binding IsMouseOver,
                                               RelativeSource={RelativeSource AncestorType={x:Type Slider}}}">
                            <Setter TargetName="Knob" Property="Width" Value="14"/>
                            <Setter TargetName="Knob" Property="Height" Value="14"/>
                        </DataTrigger>
                        <DataTrigger Value="True"
                                     Binding="{Binding IsKeyboardFocused,
                                               RelativeSource={RelativeSource AncestorType={x:Type Slider}}}">
                            <Setter TargetName="Knob" Property="Width" Value="14"/>
                            <Setter TargetName="Knob" Property="Height" Value="14"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinSlider" TargetType="{x:Type Slider}">
        <Setter Property="Height" Value="16"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <!-- Background transparente para o Grid inteiro receber o mouse,
                         senão o hover só valeria em cima da barrinha de 4px. -->
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="FillPart" Style="{StaticResource SliderFill}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ThumbPart" Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEmpty}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- A emenda do thumb muda de cor junto com a parte preenchida,
                             senão sobraria um risco branco no meio da barra vermelha. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FillPart" Property="Background" Value="{StaticResource RubyGlow}"/>
                            <Setter TargetName="ThumbPart" Property="Background" Value="{StaticResource RubyGlow}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FillPart" Property="Background" Value="{StaticResource RubyGlow}"/>
                            <Setter TargetName="ThumbPart" Property="Background" Value="{StaticResource RubyGlow}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         15. CHECKBOX COMO CHAVE (toggle)
         Um CheckBox continua sendo um CheckBox por dentro — só o
         desenho muda. A bolinha desliza com uma animação de 160ms.
         ============================================================ -->
    <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>

                        <Border Grid.Column="1" x:Name="TrackBg" Width="36" Height="20"
                                CornerRadius="{StaticResource CornerToggle}"
                                Background="{StaticResource Stroke}" VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource TextHi}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobMove" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackBg" Property="Background" Value="{StaticResource EmeraldDeep}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove"
                                                         Storyboard.TargetProperty="X"
                                                         To="16" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         15b. BOTÃO DE PLAY DO CARD (o círculo rubi que sobe no hover)
         É um Button DENTRO do Button do card: clicar nele toca na hora,
         clicar no resto do card só carrega na barra. O handler marca o
         evento como tratado para o clique não subir para o card.
         ============================================================ -->
    <Style x:Key="FabButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Ellipse x:Name="Disc" Fill="{StaticResource Ruby}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF000000" BlurRadius="14" ShadowDepth="4" Opacity="0.55"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource RubyHover}"/>
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.09" ScaleY="1.09"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource RubyDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         15c. BOTÃO DE REMOVER DO CARD
         Aparece junto com o play, no canto oposto. Fundo escuro
         translúcido para não competir com o rubi do play.
         ============================================================ -->
    <Style x:Key="CardRemoveButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Ellipse x:Name="Disc" Fill="#CC0D0D10"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource Warn}"/>
                            <Setter Property="Foreground" Value="{StaticResource Void}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         16. CARD DE SOM
         Só a "casca" clicável — o conteúdo (arte, nome, duração) vem
         do DataTemplate lá no MainWindow.xaml.
         ============================================================ -->
    <Style x:Key="CardButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="152"/>
        <Setter Property="Margin" Value="0,0,16,16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Card" Background="{StaticResource Elevated}"
                            CornerRadius="{StaticResource CornerMd}" Padding="12"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource RubyGlow}"/>
                        </Trigger>
                        <!-- Tag guarda o estado do som: o SoundItem escreve, o
                             template reage. "selected" = carregado na barra de
                             baixo mas parado; "playing" = tocando agora. -->
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource Hover}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Stroke}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="playing">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource Hover}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource RubyFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
